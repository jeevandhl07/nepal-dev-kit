{
  "name": "@jeevandhl07/nepal-dev-kit",
  "version": "0.1.4",
  "description": "Nepali calendar and Bikram Sambat date utilities for JavaScript, TypeScript, React, React Native, Expo, and Next.js.",
  "license": "MIT",
  "author": "Jeevan Dhakal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./core/calendar": {
      "import": {
        "types": "./dist/core/calendar/index.d.ts",
        "default": "./dist/core/calendar/index.js"
      },
      "require": {
        "types": "./dist/core/calendar/index.d.cts",
        "default": "./dist/core/calendar/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "require": {
        "types": "./dist/react-native/index.d.cts",
        "default": "./dist/react-native/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "nepali",
    "calendar",
    "nepali-calendar",
    "nepali-date",
    "nepali-date-picker",
    "bikram-sambat",
    "bikram-sambat-calendar",
    "bs-calendar",
    "bs-date",
    "bs-date-picker",
    "date-converter",
    "ad-to-bs",
    "bs-to-ad",
    "vikram-samvat",
    "nepal",
    "react",
    "react-native",
    "expo",
    "nextjs",
    "next-js",
    "typescript"
  ],
  "homepage": "https://github.com/jeevandhl07/nepal-dev-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeevandhl07/nepal-dev-kit"
  },
  "bugs": {
    "url": "https://github.com/jeevandhl07/nepal-dev-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
